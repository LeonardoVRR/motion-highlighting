{
  "name": "motion-highlighting",
  "displayName": "Motion Highlighting",
  "description": "Destaca visualmente tags do Framer Motion (motion.) no editor, aplicando cores customizadas para diferenciá-las de elementos HTML padrões.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Motion Highlighting",
      "properties": {
        "motionHighlighting.saturation": {
          "type": "number",
          "default": 70,
          "minimum": 0,
          "maximum": 100,
          "description": "Saturation of generated colors"
        },
        "motionHighlighting.lightness": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 100,
          "description": "Lightness of generated colors"
        },
        "motionHighlighting.highlightMode": {
          "type": "string",
          "enum": [
            "full",
            "prefix",
            "tagOnly"
          ],
          "default": "full",
          "description": "Controls which part of motion components should be highlighted."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "pnpm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.39.2",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}